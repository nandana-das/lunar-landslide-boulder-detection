# =============================================================
# Chandrayaan-2 OHRC — .gitignore
# =============================================================
# IMPORTANT: Never commit original satellite data, credentials,
# PRADAN session data, or large generated datasets.
# =============================================================

# ── PRADAN downloads (never commit) ──────────────────────────
pradan.issdc.gov.in/

# ── Satellite data archives ───────────────────────────────────
*.zip
*.ZIP

# ── Raw PDS4 science images (very large, never commit) ────────
*.img
*.IMG
*.imq
*.IMQ

# ── Extracted large binary data ───────────────────────────────
data/extracted/
data/tiles/
data/previews/
data/raw/

# ── Results / generated CSVs and logs (optional: commit summary CSVs) ──
results/quality_control/
# Uncomment below if you want to exclude all results:
# results/

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/

# ── Virtual environments ──────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Jupyter ───────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── IDEs ──────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Authentication & credentials (NEVER commit) ───────────────
*.pem
*.key
*.crt
*.env
.env*
secrets.json
credentials.json
cookies.txt
session.txt

# ── Temporary files ───────────────────────────────────────────
*.tmp
*.bak
*.log
!results/preprocessing_errors.log
tmp/
temp/

runs/
weights/
*.pt
data/tiles/
runs/
weights/
*.pt
data/tiles/
data/raw/
data/calibrated/
pradan.issdc.gov.in/
C:/ohrc_detections/
.venv/

data/annotation_sample/
data/priority_sample/
data/rmam/

data/combined/
data/combined_hm/train/
data/combined_hm/val/
data/prieur/boulder2024/
data/prieur/moon_only/
